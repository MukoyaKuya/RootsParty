# Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to the repo. In production, use platform env or Secret Manager.

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database (leave empty for SQLite in dev)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Roots Party <info@rootsparty.co.ke>

# Cloud Storage (Production only – set via env/Secret Manager)
GS_BUCKET_NAME=

# Security (Production: set DEBUG=False; ALLOWED_HOSTS to your domain(s); see SECURITY.md)
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Redis Cache (Production - Optional but Recommended)
# Format for Cloud Memorystore: redis://[IP]:6379/0
# Format for Upstash: rediss://default:[PASSWORD]@[HOST]:[PORT]
# Leave empty for development (will use in-memory cache)
REDIS_URL=

# M-PESA callback protection. Use a long random token in production.
MPESA_CALLBACK_TOKEN=

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
